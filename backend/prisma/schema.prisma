datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

/// Everyone starts as an anonymous device account. Signing in with Apple
/// attaches `appleUserId` to that same row (or merges it into the existing
/// Apple account), so the queue survives the upgrade.
model User {
  id          String      @id @default(cuid())
  deviceId    String?     @unique
  appleUserId String?     @unique
  email       String?
  createdAt   DateTime    @default(now())
  queueItems  QueueItem[]
}

/// A saved link. `audioURL` set = podcast episode the app plays;
/// `audioURL` null = web item the app opens in a web view.
model QueueItem {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalURL     String
  title           String   @default("")
  publisher       String?
  audioURL        String?
  durationSeconds Int?
  isListened      Boolean  @default(false)
  position        Int      @default(0)
  savedAt         DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, position])
}
